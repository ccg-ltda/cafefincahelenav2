APP_NAME="Cafe Finca Helena"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Correos del pedido. En local MAIL_MAILER=log (o smtp hacia Mailpit, puerto 1025). En producción: SMTP del dominio (ver DEPLOY.md).
# Con QUEUE_CONNECTION=database (producción) el scheduler envía la cola cada minuto; con sync (local) se envía al instante.
MAIL_FROM_ADDRESS="notificaciones@tu-dominio.com"
MAIL_FROM_NAME="Café Finca Helena"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_REQUIRE_PAYMENT=false
SHOP_WHATSAPP_NUMBER=
# Quién recibe los avisos de pedido pagado y de pago sobre pedido cancelado (correos separados por comas). Vacía = no se envían.
SHOP_ADMIN_NOTIFICATION_EMAILS=

# Wompi (pagos en línea). WOMPI_ENV: sandbox | production. Sin las 4 llaves la tienda no recibe pedidos.
WOMPI_ENV=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Minutos para pagar en el Web Checkout, y minutos antes de cancelar un pedido sin pago.
WOMPI_CHECKOUT_WINDOW_MINUTES=30
WOMPI_PENDING_EXPIRY_MINUTES=60
# Pedido MANUAL (lo registra el administrador): horas que dura el link de pago (expiration-time) y plazo para cancelar el pedido si nadie paga.
WOMPI_MANUAL_PENDING_EXPIRY_HOURS=24

# Seguridad (ver DEPLOY.md, sección 14b)
# CSP solo en modo reporte (el navegador avisa en la consola pero no bloquea): útil un rato si algo se rompe tras publicar.
SECURITY_CSP_REPORT_ONLY=false
# IPs/rangos de tu proxy o Cloudflare, separados por coma. Vacío = no confiar en ninguno. Nunca "*" salvo que el servidor solo reciba tráfico del proxy.
TRUSTED_PROXIES=
# Revisa contraseñas nuevas contra filtraciones conocidas (si el servicio no responde, se acepta la contraseña).
SECURITY_CHECK_PWNED=true
